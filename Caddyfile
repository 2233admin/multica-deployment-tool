{
  admin off
  auto_https off
}

http://NAS_IP:3010 {
  @backend_health path /health /readyz
  handle @backend_health {
    reverse_proxy 127.0.0.1:3011
  }

  @multica_ws path /ws /ws/*
  handle @multica_ws {
    reverse_proxy 127.0.0.1:3011 {
      flush_interval -1
    }
  }

  reverse_proxy 127.0.0.1:3012
}
