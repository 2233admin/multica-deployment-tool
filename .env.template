# Multica NAS deployment template.
#
# The deployment tool copies this file to the NAS, creates .env only once, and appends
# generated secrets there. Never paste .env into chat, tickets, or Git.
# Change the public URL values together with the Caddyfile when using another
# NAS address or port. Existing .env files are preserved during upgrades.
MULTICA_IMAGE_TAG=latest
MULTICA_BACKEND_REF=
MULTICA_WEB_REF=
# Optional image overrides for a self-maintained fork or private registry.
# Leave blank to use the official GHCR repositories.
MULTICA_BACKEND_IMAGE=
MULTICA_WEB_IMAGE=
BACKEND_PORT=3011
FRONTEND_PORT=3012
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
MULTICA_APP_URL=
# Optional target-local/server-to-server origin. The deployment tool keeps this
# separate from the browser origin when LAN, NetBird, or DNS routes differ.
MULTICA_SERVICE_URL=
MULTICA_TRUSTED_PROXIES=127.0.0.1/32
# Redis is used for auth/rate-limit, token/PAT caches, runtime liveness, and
# the single-node realtime relay. The self-host Compose file supplies the
# local default; override only when using an external Redis.
REDIS_URL=redis://redis:6379/0
REALTIME_RELAY_MODE=legacy
# Keep signup enabled only while onboarding. Set false after the first users
# are created, then run the Python deployment command again.
ALLOW_SIGNUP=true
# Set both to true to enable the V1 private skill-plugin APIs/UI.
FF_PLUGINS_V1=false
FF_PRIVATE_PLUGINS_V1=false
# Optional Gitea OAuth2/OIDC login. Set these through the deployment tool;
# do not paste the client secret into chat or source control.
GITEA_ISSUER_URL=
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
GITEA_REDIRECT_URI=
# Optional backend-only route. Use an http(s) URL, or `hostname:ip` to keep
# TLS SNI/certificate validation on the browser-facing hostname.
GITEA_BACKEND_HOST_OVERRIDE=
# Optional GitHub Device Flow for local/desktop authorization. The client ID
# is public OAuth application metadata, not a client secret. Keep the feature
# disabled until a valid client ID is supplied; LAN/NetBird use does not need
# a public callback or webhook endpoint.
GITHUB_DEVICE_FLOW_ENABLED=false
GITHUB_APP_CLIENT_ID=
# 32-byte hex key generated on the NAS; never commit or copy it into a report.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional GitHub App integration. The deployment tool writes these values
# with `multica_deploy.py github`; keep the private key out of source control.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Public HTTPS origin used for externally reachable callbacks/webhooks.
# Leave empty when this instance is LAN-only and GitHub integration is off.
MULTICA_PUBLIC_URL=
MULTICA_PLANE_URL=
MULTICA_VCS_INTEGRATION_ENABLED=true
