# Multica NAS deployment template.
#
# The deployment tool copies this file to the NAS, creates .env only once, and appends
# generated secrets there. Never paste .env into chat, tickets, or Git.
# Change the public URL values together with the Caddyfile when using another
# NAS address or port. Existing .env files are preserved during upgrades.
MULTICA_IMAGE_TAG=v0.4.26
# Optional image overrides for a self-maintained fork or private registry.
# Leave blank to use the official GHCR repositories.
MULTICA_BACKEND_IMAGE=
MULTICA_WEB_IMAGE=
BACKEND_PORT=3011
FRONTEND_PORT=3012
FRONTEND_ORIGIN=http://NAS_IP:3010
CORS_ALLOWED_ORIGINS=http://NAS_IP:3010
MULTICA_APP_URL=http://NAS_IP:3010
MULTICA_TRUSTED_PROXIES=127.0.0.1/32
# Keep signup enabled only while onboarding. Set false after the first users
# are created, then run the Python deployment command again.
ALLOW_SIGNUP=true
# Set both to true to enable the V1 private skill-plugin APIs/UI.
FF_PLUGINS_V1=false
FF_PRIVATE_PLUGINS_V1=false
# Optional Gitea OAuth2/OIDC login. Set these through the deployment tool;
# do not paste the client secret into chat or source control.
GITEA_ISSUER_URL=
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
GITEA_REDIRECT_URI=http://NAS_IP:3010/auth/callback
MULTICA_VCS_INTEGRATION_ENABLED=true
